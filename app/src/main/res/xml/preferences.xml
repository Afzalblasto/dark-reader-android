<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <PreferenceCategory app:title="General">
        <ListPreference
            app:key="settings_sort_order"
            app:title="Sort Order"
            app:entries="@array/sort_entries"
            app:entryValues="@array/sort_values"
            app:defaultValue="name_asc" />
            
        <ListPreference
            app:key="settings_view_mode"
            app:title="View Mode"
            app:entries="@array/view_entries"
            app:entryValues="@array/view_values"
            app:defaultValue="list" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Security">
        <Preference
            app:key="safe_pin"
            app:title="Safe PIN"
            app:summary="Change your Private Safe PIN" />
            
        <SwitchPreferenceCompat
            app:key="biometric_auth"
            app:title="Biometric Authentication"
            app:summary="Use fingerprint or face unlock for Private Safe"
            app:defaultValue="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Data">
        <Preference
            app:key="export_bookmarks"
            app:title="Export Bookmarks" />
            
        <Preference
            app:key="import_bookmarks"
            app:title="Import Bookmarks" />
    </PreferenceCategory>

    <PreferenceCategory app:title="About">
        <Preference
            app:key="about_version"
            app:title="Version"
            app:summary="1.0.0" />
    </PreferenceCategory>

</PreferenceScreen>
